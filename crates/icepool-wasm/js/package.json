{
  "name": "icepool-wasm",
  "version": "0.1.0",
  "description": "Exact dice probabilities: the icepool library (Python) ported to Rust, as WASM with a TypeScript API",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/web.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "!dist/internal.*",
    "pkg-node/icepool_wasm*",
    "pkg-node/package.json",
    "pkg-web/icepool_wasm*",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "./build.sh",
    "test": "./build.sh --test"
  },
  "devDependencies": {
    "typescript": ">=5.2"
  }
}
